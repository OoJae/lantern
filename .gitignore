node_modules/
# Build artifacts are ignored EXCEPT the generated contract module, which is
# committed (~32K) so `npm install && npm test` is green with no Compact
# toolchain and no Docker. CI recompiles from source and fails on any drift.
contracts/managed/*
!contracts/managed/contract/
contracts/managed/contract/*.map
contracts/managed-host/*
!contracts/managed-host/contract/
contracts/managed-host/contract/*.map
# The adversarial targets' generated modules are committed too, or
# `npm run attack` would need the Compact toolchain on a clean clone.
contracts/managed-public-guardians/*
!contracts/managed-public-guardians/contract/
contracts/managed-public-guardians/contract/*.map
contracts/managed-lantern-v0/*
!contracts/managed-lantern-v0/contract/
contracts/managed-lantern-v0/contract/*.map
*.tgz
.DS_Store
dist/
.env
.playwright-mcp/

# Internal strategy notes — must never ship in a public submission repo
buildplan.md
