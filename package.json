{
  "name": "lantern",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lantern lets hidden guardians restore a lost Midnight identity secret, and proves it is the right one.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OoJae/lantern.git"
  },
  "homepage": "https://github.com/OoJae/lantern#readme",
  "bugs": {
    "url": "https://github.com/OoJae/lantern/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "compile": "bash scripts/compile.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "cost": "bash scripts/cost.sh",
    "test:concurrent": "vitest run test/concurrency.test.js",
    "attack": "node scripts/enumerate.mjs",
    "test:adversarial": "vitest run test/adversarial.test.js",
    "compile:shipped": "bash scripts/compile.sh --shipped-only",
    "story": "node scripts/story.mjs",
    "web:install": "npm ci --prefix web --no-audit --no-fund",
    "web": "npm run dev --prefix web",
    "web:build": "npm run build --prefix web",
    "web:preview": "npm run preview --prefix web",
    "web:e2e": "npm run build --prefix web && npm run e2e --prefix web",
    "devnet": "bash devnet/run.sh",
    "devnet:verify": "node devnet/src/verify.mjs",
    "devnet:down": "docker compose -f devnet/compose.yml down -v",
    "devnet:bench": "bash devnet/run.sh bench",
    "build": "bash scripts/compile.sh",
    "compile:check": "bash scripts/compile.sh --check",
    "cost:check": "node scripts/check-cost.mjs",
    "readme:check": "node scripts/readme-facts.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-did-jubjub-schnorr": "0.7.0",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  },
  "overrides": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  }
}
