import CompactStandardLibrary;

struct GuardianEntry { owner: Bytes<32>; guardian: Bytes<32>; }
struct VoteEntry     { owner: Bytes<32>; guardian: Bytes<32>; rid: Bytes<32>; }

export ledger owners: Set<Bytes<32>>;
export ledger thresholds: Map<Bytes<32>, Uint<8>>;

// An EVM storage array, transliterated: index-addressed and iterable.
export ledger guardianList: Map<Uint<32>, GuardianEntry>;
export ledger guardianCount: Counter;

// A public voting record: who approved a takeover.
export ledger voteList: Map<Uint<32>, VoteEntry>;
export ledger voteCount: Counter;

constructor() {}

// Surfaces the warning in the generated index.d.ts, so anyone who only ever
// reads the TypeScript types still sees it. Pure, so it emits no proving key.
export pure circuit THIS_CONTRACT_IS_DELIBERATELY_INSECURE(): Uint<8> { return 1; }

export circuit enroll(owner: Bytes<32>, threshold: Uint<8>): [] {
  assert(!owners.member(disclose(owner)), "already enrolled");
  assert(disclose(threshold) >= 2, "threshold must be at least 2");
  owners.insert(disclose(owner));
  thresholds.insert(disclose(owner), disclose(threshold));
}

// THE LEAK: `guardian` is written to public state verbatim.
export circuit addGuardian(owner: Bytes<32>, guardian: Bytes<32>): [] {
  assert(owners.member(disclose(owner)), "not enrolled");
  guardianList.insert(disclose(guardianCount.read() as Uint<32>),
    GuardianEntry { owner: disclose(owner), guardian: disclose(guardian) });
  guardianCount.increment(1);
}

// And so is every vote.
export circuit approve(owner: Bytes<32>, guardian: Bytes<32>, rid: Bytes<32>): [] {
  assert(owners.member(disclose(owner)), "not enrolled");
  voteList.insert(disclose(voteCount.read() as Uint<32>),
    VoteEntry { owner: disclose(owner), guardian: disclose(guardian), rid: disclose(rid) });
  voteCount.increment(1);
}
